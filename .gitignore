# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
build/
dist/
*.egg-info/

# Node
node_modules/
.npm/

# Secrets - NEVER COMMIT
credentials.json
client_secret*.json
service_account*.json
.secret_key
.env
.env.*
*.pem
*.key

# Instrument / lab data
*.cdf
*.CDF
*.ifg
*.IFG
*.rifg
*.RIFG
*.spc
*.SPC

# Logs, databases, archives
*.log
*.log.*
*.sqlite
*.sqlite3
*.db
*.tar.gz
*.tgz
*.zip

# Binaries
*.exe
*.EXE
*.dll
*.msi

# OS
.DS_Store
Thumbs.db
desktop.ini

# QBench credential store (must live outside the repo)
qbench.json
.env

# Runtime state - lives in the data dir, never in a release
*.pid
processed_cdf*/
distill_results*.csv
.*_cache.json
*.bak_*

# CI writes the release tag into a VERSION file next to the code; a
# checkout has no VERSION and reports "dev" (see version.py).
VERSION
